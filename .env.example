# Copy to .env locally. These are development-only example values.
DATABASE_URL=postgresql://mcj_app:mcj_app_local@127.0.0.1:15432/mcj_hello
MIGRATION_DATABASE_URL=postgresql://mcj_migrate:mcj_migrate_local@127.0.0.1:15432/mcj_hello
TEST_DATABASE_URL=postgresql://mcj_migrate:mcj_migrate_local@127.0.0.1:15432/mcj_hello_test
WORKER_DATABASE_URL=postgresql://mcj_worker:mcj_worker_local@127.0.0.1:15432/mcj_hello
MCJ_DEVELOPMENT_IDENTITY=true
MCJ_SESSION_SECRET=replace-with-at-least-32-random-characters
MCJ_EVALUATOR_IMAGE=sha256:77cf9faa236790dbd636cb41c93c62f3b1a12c3e5e5630b3892eee9ba15b0534
MCJ_EVALUATOR_RUNTIME=runsc-systrap

# Linux path outside the repository; required by the worker.
MCJ_EVALUATOR_LEASE_DIRECTORY=/tmp/master-cangjie-evaluator-leases
